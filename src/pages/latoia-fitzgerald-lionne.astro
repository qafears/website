---
// The Story of Latoia Fitzgerald, Sheen Magazine. The printed page shows as a
// tear sheet, credited to the magazine and the images' source.
import WrittenInterview from '../components/WrittenInterview.astro';
import { reader } from '../lib/content';

const page = await reader.singletons.fitzgeraldInterview.readOrThrow();
---
<WrittenInterview
  page={page}
  pagePath="latoia-fitzgerald-lionne"
  headline={`${page.hero.heading} of Lionne`}
  subjects={[
    { slug: 'latoia-fitzgerald', name: 'Latoia Fitzgerald', jobTitle: 'Fashion designer, founder of Lionne' },
  ]}
  mentions={['Karrueche Tran', 'Draya Michele']}
  publishedIn={{ '@type': 'Periodical', name: 'Sheen Magazine' }}
/>
