---
/**
 * The Archives: the portfolio, grouped into sections (Celebrity, Editorial,
 * Commercial, Red carpet), and within a section into shoots.
 *
 * A section shows one tile per shoot, not one per photo: the shoot's first
 * image is its thumbnail, and clicking it opens that shoot in the lightbox
 * with prev/next scoped to it. So Garcelle Beauvais is a single tile that
 * opens four frames, rather than four tiles competing in the grid.
 *
 * Every photo is still a real <img> in the page, which is the invariant that
 * lets image search see the whole portfolio. The frames behind a tile are
 * emitted into a visually-hidden block per shoot: same markup, same alt text,
 * simply not painted until the viewer opens. They are lazy and hidden, so the
 * browser never fetches them for the grid, and the image sitemap declares
 * every one of them regardless.
 *
 * The lightbox in public/assets/js/main.js is reused unchanged: it reads the
 * gallery-data JSON block, and a tile carrying data-gallery + data-shoot opens
 * that shoot directly.
 *
 * A section with no shoots is skipped entirely, so Red carpet stays off the
 * page until its images land in content/archives.yaml.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import Picture from '../components/Picture.astro';
import { reader, SITE_ORIGIN } from '../lib/content';
import { personMinimal, breadcrumb } from '../lib/jsonld';

const archives = await reader.singletons.archives.readOrThrow();
const O = SITE_ORIGIN;

const filled = archives.sections
  .map((s) => ({ ...s, shoots: s.shoots.filter((sh) => sh.images.length > 0) }))
  .filter((s) => s.shoots.length > 0);

const plural = (n: number) => `${n} photo${n === 1 ? '' : 's'}`;

const clientNames = (archives.clients?.names || '')
  .split(',')
  .map((n) => n.trim())
  .filter(Boolean);

// One lightbox category per section, holding that section's shoots, so a tile
// opens its own shoot and prev/next stay inside it.
const galleryJson = JSON.stringify(
  Object.fromEntries(
    filled.map((s) => [
      s.key,
      {
        title: s.title,
        shoots: s.shoots.map((sh) => ({
          slug: sh.slug,
          title: sh.title,
          images: sh.images.map((im) => ({ src: im.src, cap: im.cap })),
        })),
      },
    ])
  )
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${O}/archives#webpage`,
      url: `${O}/archives`,
      name: archives.seo.ogTitle,
      isPartOf: { '@id': `${O}/#website` },
      about: { '@id': `${O}/#person` },
      inLanguage: 'en',
      hasPart: filled.flatMap((s) =>
        s.shoots.map((sh) => ({
          '@type': 'ImageGallery',
          name: `${s.title}: ${sh.title}`,
          image: sh.images.map((im) => `${O}/${im.src}`),
        }))
      ),
      // Names the page is genuinely about, so a search engine can connect this
      // page to each client as an entity rather than only as a string.
      ...(clientNames.length
        ? { mentions: clientNames.map((name) => ({ '@type': 'Person', name })) }
        : {}),
    },
    personMinimal(),
    breadcrumb([
      { name: 'Home', item: `${O}/` },
      { name: 'The Archives', item: `${O}/archives` },
    ]),
  ],
};
---
<BaseLayout
  pagePath="archives"
  title={archives.seo.title}
  description={archives.seo.description}
  ogTitle={archives.seo.ogTitle}
  ogDescription={archives.seo.ogDescription}
  ogType={archives.seo.ogType}
  navCurrent="archives"
  jsonLd={jsonLd}
>

  <section class="page-hero">
    <div class="wrap reveal">
      <p class="eyebrow">{archives.hero.eyebrow}</p>
      <h1>{archives.hero.heading}</h1>
      <p>{archives.hero.intro}</p>
    </div>
  </section>

  {filled.map((s, si) => (
    <Fragment>
      {si > 0 && <hr class="rule">}
      <section class="section" id={s.key} style={si === 0 ? 'padding-top:0' : undefined}>
        <div class="wrap">
          <div class="sec-head reveal">
            <p class="eyebrow">The Archives</p>
            <h2>{s.title}</h2>
            <p>{s.intro}</p>
          </div>
          <div class="archive archive--page">
            {s.shoots.map((sh) => (
              <figure class="ph ph--tall reveal">
                <Picture
                  src={sh.images[0].src}
                  alt={sh.images[0].alt}
                  loading="lazy"
                  sizes="(min-width: 1000px) 30vw, (min-width: 680px) 46vw, 92vw"
                />
                <button
                  type="button"
                  class="ph-link"
                  data-gallery={s.key}
                  data-shoot={sh.slug}
                  data-src={sh.images[0].src}
                  aria-label={`Open the ${sh.title} shoot, ${plural(sh.images.length)}`}
                ><span class="go">View</span></button>
                <figcaption class="cap">
                  <span>{sh.title}</span>
                  {sh.images.length > 1 && <em class="cap__count">{plural(sh.images.length)}</em>}
                </figcaption>
              </figure>
            ))}
          </div>

          {/* The frames behind each tile, as real markup so image search sees
              the whole shoot and not just its thumbnail. Hidden and lazy, so
              the grid never fetches them; the lightbox paints them on click. */}
          <div class="archive-frames" aria-hidden="true">
            {s.shoots.flatMap((sh) =>
              sh.images.slice(1).map((im) => (
                <img src={im.src} alt={im.alt} loading="lazy" decoding="async" width="400" height="533" />
              ))
            )}
          </div>
        </div>
      </section>
    </Fragment>
  ))}

  {/* Named clients as plain page text. Alt text alone is a weak signal for a
      person's name; a real sentence naming them is what a search for that name
      can actually match. */}
  {archives.clients && archives.clients.names && (
    <div class="wrap">
      <div class="arch-clients reveal">
        <p class="eyebrow">{archives.clients.label}</p>
        <p>{archives.clients.names}</p>
      </div>
    </div>
  )}

  {archives.footnote && (
    <div class="wrap">
      <p class="arch-footnote reveal">{archives.footnote}</p>
    </div>
  )}

  <Cta
    heading={archives.cta.heading}
    body={archives.cta.body}
    buttonLabel={archives.cta.buttonLabel}
    buttonHref={archives.cta.buttonHref}
  />

  <Fragment slot="after-footer">
    <script id="gallery-data" type="application/json" is:inline set:html={galleryJson}></script>
  </Fragment>

</BaseLayout>
