---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import Picture from '../components/Picture.astro';
import { reader, SITE_ORIGIN } from '../lib/content';
import { personMinimal, breadcrumb } from '../lib/jsonld';

const work = await reader.singletons.work.readOrThrow();
const galleries = await reader.singletons.galleries.readOrThrow();
const O = SITE_ORIGIN;

// Build the lightbox JSON from the galleries singleton, keyed by category key.
// Each category holds its photo shoots; each shoot holds its own ordered image
// list (the first image doubles as the shoot's thumbnail in the category view).
const galleryData = Object.fromEntries(
  galleries.sets.map((set) => [
    set.key,
    {
      title: set.title,
      shoots: set.shoots.map((sh) => ({
        slug: sh.slug,
        title: sh.title,
        images: sh.images.map((im) => ({ src: im.src, cap: im.cap })),
      })),
    },
  ])
);
const galleryJson = JSON.stringify(galleryData);
const galleryTitle = (key: string) =>
  galleries.sets.find((s) => s.key === key)?.title || key;

const pad = (n: number) => String(n).padStart(2, '0');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${O}/work#webpage`,
      url: `${O}/work`,
      name: work.seo.ogTitle,
      isPartOf: { '@id': `${O}/#website` },
      about: { '@id': `${O}/#person` },
      inLanguage: 'en',
    },
    personMinimal(),
    breadcrumb([
      { name: 'Home', item: `${O}/` },
      { name: 'Work', item: `${O}/work` },
    ]),
  ],
};
---
<BaseLayout
  pagePath="work"
  title={work.seo.title}
  description={work.seo.description}
  ogTitle={work.seo.ogTitle}
  ogDescription={work.seo.ogDescription}
  ogType={work.seo.ogType}
  navCurrent="work"
  jsonLd={jsonLd}
>

  <section class="page-hero">
    <div class="wrap reveal">
      <p class="eyebrow">{work.hero.eyebrow}</p>
      <h1>{work.hero.heading}</h1>
      <p>{work.hero.intro}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      {work.cases.map((c, i) => (
        <article class={i % 2 === 1 ? 'case case--flip reveal' : 'case reveal'}>
          <figure class="ph ph--portrait case__media" data-tag={c.image.tag} data-label={c.image.label}>
            <Picture src={c.image.src} alt={c.image.alt} loading="lazy" sizes="(min-width: 820px) 48vw, 92vw" onerror="this.remove()" />{c.gallery && <button type="button" class="ph-link" data-gallery={c.gallery} aria-label={`Open the ${galleryTitle(c.gallery)} gallery`}><span class="go">View</span></button>}
          </figure>
          <div>
            <div class="case__kicker"><span class="case__idx">{pad(i + 1)}</span><span class="case__tag">{c.tag}</span></div>
            <h2>{c.title}</h2>
            <dl class="case__meta">
              {c.meta.map((m) => (
                <div><dt>{m.dt}</dt><dd set:html={m.dd}></dd></div>
              ))}
            </dl>
            {c.footerKind === 'note' && <p class="attribution">{c.footerText}</p>}
            {c.footerKind === 'link' && <a class="link-more" href={c.footerHref}>{c.footerText} <span>&rarr;</span></a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <hr class="rule">

  <!-- The full portfolio lives on The Archives; this is the pointer to it. -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="eyebrow">The Archives</p>
        <h2>A decade of execution.</h2>
        <p>Celebrity, editorial, commercial, red carpet. The point of view above is earned, and the archive is the work it is built on.</p>
        <p style="margin-top:1.75rem"><a class="btn btn--gold" href="archives">Open the archives <span class="btn__arrow">&rarr;</span></a></p>
      </div>
    </div>
  </section>

  <!-- VIDEO: self-hosted vertical video (curated) or a link out to YouTube/Instagram -->
  {work.video && work.video.items.length > 0 && (
    <Fragment>
      <hr class="rule">
      <section class="section">
        <div class="wrap">
          <div class="sec-head reveal">
            <p class="eyebrow">{work.video.eyebrow}</p>
            <h2>{work.video.heading}</h2>
            {work.video.intro && <p>{work.video.intro}</p>}
          </div>
          <div class="reels">
            {work.video.items.map((r) => {
              const platform = r.permalink && /youtu\.?be/i.test(r.permalink) ? 'YouTube' : 'Instagram';
              return r.videoSrc ? (
                <figure class="reel-card reveal" data-video={r.videoSrc} data-poster={r.poster.src} role="button" tabindex="0" aria-label={`Play video: ${r.caption}`}>
                  <div class="ph reel-card__media" data-tag={r.poster.tag} data-label={r.poster.label}>
                    <Picture src={r.poster.src} alt={r.poster.alt} sizes="(min-width: 900px) 25vw, (min-width: 640px) 33vw, 46vw" loading="lazy" onerror="this.remove()" />
                    <span class="reel__play"><span><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="#f3efe6"/></svg></span></span>
                  </div>
                  <figcaption class="reel-card__cap">{r.caption}</figcaption>
                </figure>
              ) : (
                <figure class="reel-card reveal">
                  <a class="ph reel-card__media" href={r.permalink} target="_blank" rel="noopener" aria-label={`Watch on ${platform}: ${r.caption}`} data-tag={r.poster.tag} data-label={r.poster.label}>
                    <Picture src={r.poster.src} alt={r.poster.alt} sizes="(min-width: 900px) 25vw, (min-width: 640px) 33vw, 46vw" loading="lazy" onerror="this.remove()" />
                    <span class="reel-card__ig">Watch on {platform} ↗</span>
                  </a>
                  <figcaption class="reel-card__cap">{r.caption}</figcaption>
                </figure>
              );
            })}
          </div>
        </div>
      </section>
    </Fragment>
  )}

  <Cta
    heading={work.cta.heading}
    body={work.cta.body}
    buttonLabel={work.cta.buttonLabel}
    buttonHref={work.cta.buttonHref}
  />

  <Fragment slot="after-footer">
    <script id="gallery-data" type="application/json" is:inline set:html={galleryJson}></script>
  </Fragment>

</BaseLayout>
